    "decimal": {
      "description": "A decimal number written as a string, so no binary rounding changes it.",
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "money": {
      "description": "An amount of money in one currency.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/decimal"
        },
        "currency": {
          "$ref": "#/definitions/currency"
        }
      }
    },
    "instant": {
      "description": "A moment in time: an RFC 3339 date-time with its offset from UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "date": {
      "description": "A calendar date: ISO 8601 YYYY-MM-DD.",
      "type": "string",
      "format": "date"
    },
    "duration": {
      "description": "A length of time: an ISO 8601 duration (P1Y2M3DT4H5M6S, P2W).",
      "type": "string",
      "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?)?$"
    },
    "fraction": {
      "description": "A ratio between 0 and 1. A percent is how a fraction is shown, not how it is stored.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ghgMass": {
      "description": "A mass of greenhouse gas: its value, its unit (KGM or TNE), the gas, and the global warming potential basis it is expressed on, as ISO 14067 and EN 15804+A2 declare it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "uom",
        "gas",
        "gwpBasis"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "uom": {
          "type": "string",
          "enum": [
            "KGM",
            "TNE"
          ]
        },
        "gas": {
          "type": "string",
          "enum": [
            "CO2e",
            "CO2",
            "CH4",
            "N2O"
          ],
          "description": "CO2e is the carbon dioxide equivalent of the gases declared."
        },
        "gwpBasis": {
          "type": "string",
          "enum": [
            "IPCC-AR6-GWP100",
            "IPCC-AR5-GWP100",
            "IPCC-AR4-GWP100"
          ],
          "description": "The IPCC assessment report and 100-year horizon the CO2 equivalence uses."
        }
      }
    },
    "coordinateUnits": {
      "description": "The units a coordinate space is written in: a length unit and a plane-angle unit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length"
      ],
      "properties": {
        "length": {
          "$ref": "#/definitions/uom"
        },
        "angle": {
          "type": "string",
          "enum": [
            "DD",
            "C81"
          ]
        }
      }
    },
    "unitSystem": {
      "description": "How a viewer prefers quantities shown. Display only: a stored value keeps its own unit.",
      "type": "string",
      "enum": [
        "metric",
        "us-customary"
      ]
    }
  }
}
