{
  "name": "@ectropy/schemas",
  "version": "1.0.0",
  "description": "The Ectropy open standard: JSON Schemas served at https://schemas.ectropy.ai/ and TypeScript types generated from them.",
  "license": "Apache-2.0",
  "homepage": "https://schemas.ectropy.ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ectropy-ai/schemas.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.schema.json": "./*.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "_definitions",
    "flow",
    "payroll",
    "pm",
    "resource",
    "voxel"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/check.test.mjs scripts/check-served.test.mjs",
    "served": "node scripts/check-served.mjs",
    "build": "node scripts/build-types.mjs && tsc -p tsconfig.json",
    "site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "^5.6.3"
  },
  "private": true
}
