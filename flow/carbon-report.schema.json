{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.ectropy.ai/flow/carbon-report.schema.json",
  "title": "Carbon Report",
  "version": "0.3.0",
  "description": "The carbon output a tenant or owner receives: design and measured carbon by life-cycle module (RICS Whole Life Carbon Assessment 2nd ed., EN 15978 or CALGreen 5.409.4) and ICMS 3 Level 2 category, in kgCO2e and kgCO2e per m2 GIA (IPMS 2). Each figure carries its basis. The reconciliation method that produces it is not part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportId",
    "projectRef",
    "reportingStandard",
    "classification",
    "gia",
    "lines"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "projectRef": {
      "$ref": "https://schemas.ectropy.ai/flow/flow-common.schema.json#/definitions/projectUri"
    },
    "reportingStandard": {
      "enum": [
        "RICS-WLCA-2",
        "EN-15978",
        "CALGreen-5.409.4"
      ],
      "description": "The method the report follows: RICS Whole Life Carbon Assessment 2nd ed.; EN 15978 (the basis of the EU Energy Performance of Buildings Directive life-cycle GWP); or the whole-building life-cycle assessment path of California's CALGreen section 5.409.4."
    },
    "classification": {
      "const": "ICMS-3"
    },
    "studyPeriodYears": {
      "type": "integer",
      "minimum": 1
    },
    "gia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "uom",
        "standard"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "uom": {
          "const": "MTK"
        },
        "standard": {
          "const": "IPMS-2"
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "icmsCategory",
          "module",
          "design",
          "measured"
        ],
        "properties": {
          "icmsCategory": {
            "enum": [
              "Acquisition",
              "Construction",
              "Renewal",
              "Operation",
              "Maintenance",
              "End of life"
            ]
          },
          "icmsGroup": {
            "type": "string"
          },
          "module": {
            "enum": [
              "A0",
              "A1-A3",
              "A4",
              "A5.1",
              "A5.2",
              "A5.3",
              "A5.4",
              "B1",
              "B2",
              "B3",
              "B4",
              "B5",
              "B6",
              "B7",
              "B8",
              "C1",
              "C2",
              "C3",
              "C4",
              "D"
            ]
          },
          "design": {
            "$ref": "https://schemas.ectropy.ai/flow/flow-common.schema.json#/definitions/figure"
          },
          "measured": {
            "$ref": "https://schemas.ectropy.ai/flow/flow-common.schema.json#/definitions/figure"
          },
          "partRef": {
            "type": "string",
            "minLength": 1,
            "description": "The fabricated part or assembly the line covers, when it covers one."
          },
          "lotRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "The lots the line's figure covers, as a logistic unit's contents name them."
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upfrontKgCo2e": {
          "type": "number"
        },
        "embodiedKgCo2e": {
          "type": "number"
        },
        "upfrontKgCo2ePerM2Gia": {
          "type": "number"
        }
      }
    }
  }
}
